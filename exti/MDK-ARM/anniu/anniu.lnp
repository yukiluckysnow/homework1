"anniu\stm32f1xx_hal_msp.o"
"anniu\stm32f1xx_hal_gpio_ex.o"
"anniu\stm32f1xx_hal.o"
"anniu\stm32f1xx_hal_rcc.o"
"anniu\stm32f1xx_hal_rcc_ex.o"
"anniu\stm32f1xx_hal_gpio.o"
"anniu\stm32f1xx_hal_dma.o"
